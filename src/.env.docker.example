# .env.docker.example = versionné
# .env.docker         = non versionné

# Ce fichier regroupe les variables d'environnement à fournir au docker-compose pour le lancement des différents services

# Local : 
#        docker compose --env-file=.env.docker.example
# (ou)   docker compose --env-file=.env.docker

# Prod :  
#        docker compose --env-file=.env.docker


# OQUIZ_DATABASE
POSTGRES_OQUIZ_USER=oquiz
POSTGRES_OQUIZ_PASSWORD=oquiz
POSTGRES_OQUIZ_DB=oquiz

# FILES_DATABASE
POSTGRES_FILES_USER=file_upload_service
POSTGRES_FILES_PASSWORD=file_upload_service
POSTGRES_FILES_DB=file_upload_service

# FILE SERVICE
FILES_DATABASE_URL=postgres://file_upload_service:file_upload_service@files-database:5432/file_upload_service

# API
NODE_ENV=production
OQUIZ_DATABASE_URL=postgres://oquiz:oquiz@oquiz-database:5432/oquiz
JWT_SECRET=a-remplacer-par-une-longue-chaine-aleatoire
# ALLOWED_ORIGINS=http://localhost:5173 # allow request from client for dev
ALLOWED_ORIGINS=https://oquiz.test # origine du navigateur

# CLIENT
# VITE_API_BASE_URL=http://localhost:3000/api # API URL for dev
VITE_API_BASE_URL=https://api.oquiz.test/api # accès navigateur via nginx

# ADMINER
ADMINER_LOCAL_PORT=8880

# MONGO EXPRESS
MONGO_EXPRESS_PORT=8881

# NGINX PROXY
CLIENT_SERVER_NAME=oquiz.test # URL de déploiement du client
API_SERVER_NAME=api.oquiz.test # URL de déploiement de l'API

# pour uploader une image : curl -X POST "https://api.oquiz.test/api/files" -F "image=@./sample.jpg;type=image/jpeg"
# pour récupérer l'image : https://api.oquiz.test/api/files/1

